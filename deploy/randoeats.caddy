# randoeats — Drogon BFF proxying Google Places (in-memory cache, no DB).
# Shipped to tekadept-bff at /etc/caddy/conf.d/randoeats.caddy by deploy.yml.
# The Google Places key lives in the mounted config.json, never in the image.
api.randoeats.com {
    # Access log for cache-efficiency monitoring. randoeats is a pure
    # reverse-proxy target, so the `duration` field is the app's own response
    # time: an in-memory cache HIT returns in ~1ms, a MISS makes a Google Places
    # round-trip (~100-300ms). The tekadept-bff dashboard splits on that gap.
    # /var/log/caddy is created by the platform provisioner.
    log {
        output file /var/log/caddy/randoeats-access.log {
            roll_size 20mb
            roll_keep 5
            roll_keep_for 336h
        }
        format json
    }

    reverse_proxy localhost:8848
}
